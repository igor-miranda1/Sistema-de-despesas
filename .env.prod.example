NODE_ENV=production
APP_DOMAIN=app.example.com
API_PORT=3001
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=despesas
DB_APP_USER=despesas_app
DB_APP_PASSWORD=replace-with-a-secret
DB_MIGRATOR_USER=despesas_migrator
DB_MIGRATOR_PASSWORD=replace-with-a-secret
MYSQL_ROOT_PASSWORD=replace-with-a-secret
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY=1
EMAIL_TRANSPORT=smtp
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM=replace-with-verified@example.com
EMAIL_DAILY_CAP=200
RESET_CODE_SECRET=replace-with-at-least-32-random-characters
EMAIL_DNS_CHECK=true
EMAIL_ALLOW_TEST_DOMAINS=false
