# Configuração pública do frontend
VITE_APP_NAME="Despesas — Painel financeiro"
VITE_LOCALE=pt-BR
VITE_CURRENCY=BRL

# Credenciais locais de desenvolvimento do MySQL (substitua antes de usar)
MYSQL_DATABASE=despesas
DB_APP_USER=despesas_app
DB_APP_PASSWORD=troque_esta_senha_local
DB_MIGRATOR_USER=despesas_migrator
DB_MIGRATOR_PASSWORD=troque_esta_senha_migrator
MYSQL_ROOT_PASSWORD=troque_a_senha_root_local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
API_PORT=3001
JWT_SECRET=configure-uma-chave-aleatoria-segura-de-pelo-menos-32-bytes
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_TRANSPORT=console
SMTP_HOST=replace-in-development
SMTP_PORT=587
SMTP_USER=replace-in-development
SMTP_PASS=replace-in-development
EMAIL_FROM=replace-in-development@example.test
EMAIL_DAILY_CAP=200
RESET_CODE_SECRET=replace-with-at-least-32-random-characters
EMAIL_DNS_CHECK=true
EMAIL_ALLOW_TEST_DOMAINS=true
